<div
  class="sac-root"
  data-title="{{ block.settings.title | escape }}"
  data-accent="{{ block.settings.accent }}"
  data-background="{{ block.settings.background }}"
  data-text="{{ block.settings.text_color }}"
  data-width="{{ block.settings.width }}"
  data-font-size="{{ block.settings.font_size }}"
  data-icon="{{ block.settings.launcher_icon }}"
  data-enable-faq="{{ block.settings.enable_faq }}"
  data-enable-recommendations="{{ block.settings.enable_recommendations }}"
  data-human-help-label="{{ block.settings.human_help_label | escape }}"
  data-support-title="{{ block.settings.support_title | escape }}"
  data-support-description="{{ block.settings.support_description | escape }}"
  data-support-name-label="{{ block.settings.support_name_label | escape }}"
  data-support-name-placeholder="{{ block.settings.support_name_placeholder | escape }}"
  data-support-email-label="{{ block.settings.support_email_label | escape }}"
  data-support-email-placeholder="{{ block.settings.support_email_placeholder | escape }}"
  data-support-submit-label="{{ block.settings.support_submit_label | escape }}"
  data-support-cancel-label="{{ block.settings.support_cancel_label | escape }}"
  data-support-submitting-label="{{ block.settings.support_submitting_label | escape }}"
  data-support-contact-notice="{{ block.settings.support_contact_notice | escape }}"
  data-support-saved-email-notice="{{ block.settings.support_saved_email_notice | escape }}"
  data-support-success-message="{{ block.settings.support_success_message | escape }}"
  data-support-issue-type-label="{{ block.settings.support_issue_type_label | escape }}"
  data-support-type-placeholder="{{ block.settings.support_type_placeholder | escape }}"
  data-support-other-option="{{ block.settings.support_other_option | escape }}"
  data-support-details-label="{{ block.settings.support_details_label | escape }}"
  data-support-details-placeholder="{{ block.settings.support_details_placeholder | escape }}"
></div>
<link rel="stylesheet" href="{{ 'concierge.css' | asset_url }}">
<script src="{{ 'concierge.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "ShopAI Concierge",
  "target": "body",
  "settings": [
    { "type": "text", "id": "title", "label": "Widget heading", "default": "How can we help?" },
    { "type": "color", "id": "accent", "label": "Accent color", "default": "#f97316" },
    { "type": "color", "id": "background", "label": "Widget background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#171717" },
    { "type": "range", "id": "width", "label": "Widget width", "min": 320, "max": 440, "step": 10, "unit": "px", "default": 380 },
    { "type": "range", "id": "font_size", "label": "Font size", "min": 13, "max": 18, "step": 1, "unit": "px", "default": 14 },
    { "type": "checkbox", "id": "enable_order_lookup", "label": "Enable order tracking", "default": true },
    { "type": "checkbox", "id": "enable_faq", "label": "Enable FAQs", "default": true },
    { "type": "checkbox", "id": "enable_recommendations", "label": "Enable product recommendations", "default": true },
    { "type": "select", "id": "launcher_icon", "label": "Launcher icon", "default": "chat", "options": [{ "value": "chat", "label": "Chat bubble" }, { "value": "help", "label": "Help" }, { "value": "spark", "label": "Spark" }] },
    { "type": "header", "content": "Customer support request" },
    { "type": "text", "id": "human_help_label", "label": "Support button", "default": "Contact support" },
    { "type": "text", "id": "support_title", "label": "Request title", "default": "Submit a support request" },
    { "type": "textarea", "id": "support_description", "label": "Request description", "default": "Tell us what you need help with. Our team will follow up by email." },
    { "type": "text", "id": "support_name_label", "label": "Name field label", "default": "Your name" },
    { "type": "text", "id": "support_name_placeholder", "label": "Name placeholder", "default": "Name" },
    { "type": "text", "id": "support_email_label", "label": "Email field label", "default": "Email for follow-up" },
    { "type": "text", "id": "support_email_placeholder", "label": "Email placeholder", "default": "you@example.com" },
    { "type": "text", "id": "support_submit_label", "label": "Submit button", "default": "Create support request" },
    { "type": "text", "id": "support_submitting_label", "label": "Submitting button", "default": "Creating ticket…" },
    { "type": "text", "id": "support_cancel_label", "label": "Cancel button", "default": "Cancel" },
    { "type": "text", "id": "support_contact_notice", "label": "Contact details hint", "default": "Please add a name and email so the team can reply to your request." },
    { "type": "text", "id": "support_saved_email_notice", "label": "Saved email hint", "default": "Saved for this chat: {email}. Confirm it or enter a different email." },
    { "type": "text", "id": "support_success_message", "label": "Ticket confirmation", "default": "Ticket {ticket} created successfully. We’ll contact you soon." },
    { "type": "text", "id": "support_issue_type_label", "label": "Request type field label", "default": "Select a request type" },
    { "type": "text", "id": "support_type_placeholder", "label": "Request type placeholder", "default": "Choose a support topic" },
    { "type": "text", "id": "support_other_option", "label": "Other request option", "default": "Other" },
    { "type": "text", "id": "support_details_label", "label": "Request details label", "default": "Tell us more (optional)" },
    { "type": "text", "id": "support_details_placeholder", "label": "Request details placeholder", "default": "Add any details that may help the team…" }
  ]
}
{% endschema %}
