# Shopify CLI supplies app credentials during local development.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products,read_content,read_orders,write_products,write_metaobjects,write_metaobject_definitions,write_app_proxy
SHOPIFY_APP_URL=https://shop-ai-concierge.vercel.app
SHOP_CUSTOM_DOMAIN=

# Supabase Postgres (use the Session pooler URL from Supabase → Connect).
# DATABASE_URL uses the transaction pooler (6543, pgbouncer=true); DIRECT_URL uses
# the session pooler (5432) for Prisma migrations. Local SQLite is disabled.
DATABASE_URL=
DIRECT_URL=

# Supabase project connection (server-side only; never expose service role key in storefront code).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
# Legacy alternative: SUPABASE_SERVICE_ROLE_KEY= (never use a publishable key here)

# Gemini API key from Google AI Studio. Keep server-side; never expose in theme code.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# App security / public widget access
SESSION_SECRET=
STOREFRONT_ALLOWED_ORIGINS=
